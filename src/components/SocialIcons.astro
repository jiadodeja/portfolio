---
const links = [
  { href: 'https://www.linkedin.com/in/jiadodeja', icon: 'linkedin', label: 'LinkedIn' },
  { href: 'https://github.com/jiadodeja', icon: 'github', label: 'GitHub' },
  { href: 'mailto:hello@jiadodeja.com', icon: 'mail', label: 'Email' },
];
---
<div class="social-icons">
  {links.map(l => (
    <a href={l.href} class="sicon" aria-label={l.label} target={l.icon !== 'mail' ? '_blank' : undefined} rel="noopener noreferrer">
      {l.icon === 'linkedin' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
      )}
      {l.icon === 'github' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.49-1.11-1.49-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.31.1-2.73 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.9-1.33 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.71 1.03 1.62 1.03 2.74 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.2C22 6.58 17.52 2 12 2z"/></svg>
      )}
      {l.icon === 'mail' && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
      )}
    </a>
  ))}
</div>

<style>
  .social-icons {
    display: flex;
    gap: 12px;
  }
  .sicon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--tan);
    color: var(--terracotta);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s ease;
  }
  .sicon:hover {
    transform: translateY(-4px) rotate(-6deg) scale(1.08);
    background: var(--terracotta-light);
  }
</style>

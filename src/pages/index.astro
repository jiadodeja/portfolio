---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Motes from '../components/Motes.astro';
import { projects } from '../data/projects.js';

const featured = projects.slice(0, 3);

const articles = [
  { title: 'Why I started writing about systems', href: 'https://www.linkedin.com/in/jiadodeja' },
  { title: 'Lessons from my first internship', href: 'https://www.linkedin.com/in/jiadodeja' },
];
---
<Base>
  <section class="hero">
    <div class="wrap hero-inner">
      <Motes />
      <div class="hero-text">
        <p class="hero-kicker">Software developer</p>
        <h1 class="hero-name">Jia Dodeja</h1>
        <p class="hero-line">
          I shower regularly, prefer coffee over energy drinks, and still somehow ship full-stack apps
          and other cool projects along the way.
        </p>
        <div class="hero-actions">
          <a href="/projects" class="btn btn-primary">View projects</a>
          <a href="/contact" class="btn btn-secondary">Get in touch</a>
        </div>
      </div>
      <div class="hero-photo">
        <span>your photo</span>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <p class="label">Things I've built</p>
      <div class="project-grid">
        {featured.map((p) => (
          <ProjectCard name={p.name} href={p.href} tagline={p.tagline} live={p.live} />
        ))}
      </div>
      <a href="/projects" class="see-all">See all projects →</a>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <p class="label">Things I've authored</p>
      <div class="article-list">
        {articles.map((a) => (
          <a class="article-row" href={a.href} target="_blank" rel="noopener noreferrer">
            <span>{a.title}</span>
            <span class="article-arrow">LinkedIn →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .hero-inner {
      position: relative;
      display: flex;
      align-items: center;
      gap: 36px;
      padding: 4rem 28px 3rem;
      overflow: hidden;
    }
    .hero-text {
      position: relative;
      z-index: 1;
      flex: 1;
    }
    .hero-kicker {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 1.05rem;
      color: var(--terracotta);
      margin: 0;
    }
    .hero-name {
      font-size: 2.4rem;
      font-weight: 700;
      color: var(--ink);
      margin: 0.5rem 0 0;
    }
    .hero-line {
      font-size: 1rem;
      color: var(--brown-muted);
      max-width: 460px;
      margin: 0.9rem 0 0;
      line-height: 1.7;
    }
    .hero-actions {
      display: flex;
      gap: 12px;
      margin-top: 1.5rem;
    }
    .hero-photo {
      position: relative;
      z-index: 1;
      flex-shrink: 0;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      background: var(--paper);
      border: 2px solid var(--terracotta-light);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      color: var(--border-warm);
    }
    .project-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
    }
    .see-all {
      display: inline-block;
      margin-top: 18px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--terracotta);
    }
    .article-list {
      display: flex;
      flex-direction: column;
    }
    .article-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 0;
      border-bottom: 1px solid var(--border-soft);
      transition: padding-left 0.2s ease, color 0.2s ease;
    }
    .article-row:hover {
      padding-left: 6px;
      color: var(--terracotta);
    }
    .article-row span:first-child {
      font-size: 0.94rem;
      color: var(--ink);
    }
    .article-row:hover span:first-child {
      color: var(--terracotta);
    }
    .article-arrow {
      font-size: 0.78rem;
      color: var(--brown-faint);
      flex-shrink: 0;
      margin-left: 12px;
    }
    @media (max-width: 640px) {
      .hero-inner {
        flex-direction: column;
        text-align: center;
        padding-top: 2.5rem;
      }
      .hero-line {
        margin-left: auto;
        margin-right: auto;
      }
      .hero-actions {
        justify-content: center;
      }
    }
  </style>
</Base>
